{
	"name": "oveejs-toolkit-monorepo",
	"version": "3.0.0-alpha.0",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter playground dev",
		"serve": "pnpm dev",
		"demo": "pnpm --filter demo dev",
		"demo:dev": "pnpm --filter demo dev",
		"demo:preview": "pnpm --filter demo preview",
		"playground:dev": "pnpm --filter playground dev",
		"playground:preview": "pnpm --filter playground preview",
		"playground": "esr ./scripts/playground.ts",
		"generate": "esr ./scripts/generate.ts",
		"build": "esr ./scripts/build.ts",
		"publish": "esr ./scripts/publish.ts",
		"version_sync": "esr ./scripts/version-sync.ts",
		"test": "echo \"Error: no test specified\" && exit 1",
		"lint": "pnpm eslint && pnpm stylelint",
		"lint:no-fix": "pnpm eslint:no-fix && pnpm stylelint:no-fix",
		"eslint": "eslint \"packages/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"demo/**/*.{ts,tsx}\" --fix",
		"eslint:no-fix": "eslint \"packages/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx}\" \"demo/**/*.{ts,tsx}\"",
		"mcp:build": "cd scripts/mcp-ovee && npm install && npm run build",
		"mcp:dev": "cd scripts/mcp-ovee && npm install && npm run build && node dist/server.js",
		"stylelint": "stylelint packages/**/*.{html,css,sass,scss} --fix",
		"stylelint:no-fix": "stylelint packages/**/*.{html,css,sass,scss}",
		"postinstall": "husky install",
		"prepublishOnly": "pinst --disable",
		"postpublish": "pinst --enable"
	},
	"pnpm": {
		"overrides": {
			"ovee.js": "3.0.0-alpha.9"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/owlsdepartment/oveejs-toolkit"
	},
	"devDependencies": {
		"@commitlint/cli": "^16.1.0",
		"@commitlint/config-conventional": "^16.0.0",
		"@rollup/plugin-alias": "^3.1.9",
		"@rollup/plugin-node-resolve": "^13.3.0",
		"@rollup/plugin-typescript": "^8.3.2",
		"@types/eslint": "^8.4.1",
		"@types/google.maps": "^3.65.2",
		"@types/lodash": "^4.17.24",
		"@types/node": "^17.0.12",
		"@typescript-eslint/eslint-plugin": "^5.10.1",
		"@typescript-eslint/parser": "^5.10.1",
		"commander": "^9.0.0",
		"esbuild": "^0.14.14",
		"esbuild-plugin-alias": "^0.2.1",
		"esbuild-runner": "^2.2.1",
		"eslint": "^8.2.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-html": "^6.2.0",
		"eslint-plugin-prettier": "^4.0.0",
		"eslint-plugin-simple-import-sort": "^7.0.0",
		"husky": "^7.0.0",
		"lodash": "^4.18.1",
		"ovee.js": "3.0.0-alpha.9",
		"pinst": "^2.0.0",
		"prettier": "^2.4.1",
		"rollup": "^2.74.1",
		"rollup-plugin-dts": "^4.2.2",
		"rollup-plugin-esbuild": "^4.9.1",
		"rollup-plugin-typescript-paths": "^1.3.1",
		"sass": "^1.49.0",
		"stylelint": "^14.2.0",
		"stylelint-config-recommended-vue": "^1.1.0",
		"stylelint-config-standard-scss": "^3.0.0",
		"stylelint-order": "^5.0.0",
		"typescript": "^5.6.2"
	},
	"packageManager": "pnpm@9.15.9"
}
