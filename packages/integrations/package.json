{
  "name": "@ovee.js/toolkit-integrations",
  "author": "Owls Department",
  "license": "MIT",
  "version": "3.0.0-alpha.0",
  "description": "Ovee.js frontend toolkit developed by Owls Department",
  "bugs": {
    "url": "https://github.com/owlsdepartment/oveejs-toolkit/issues"
  },
  "homepage": "https://github.com/owlsdepartment/oveejs-toolkit#readme",
  "keywords": [
    "ui",
    "ovee.js",
    "toolkit",
    "components"
  ],
  "main": "index.cjs",
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./*": "./*",
    "./base-slider": {
      "types": "./base-slider.d.ts",
      "import": "./base-slider.mjs",
      "require": "./base-slider.cjs"
    },
    "./c15t": {
      "types": "./c15t.d.ts",
      "import": "./c15t.mjs",
      "require": "./c15t.cjs"
    },
    "./google-map": {
      "types": "./google-map.d.ts",
      "import": "./google-map.mjs",
      "require": "./google-map.cjs"
    },
    "./lazy-load": {
      "types": "./lazy-load.d.ts",
      "import": "./lazy-load.mjs",
      "require": "./lazy-load.cjs"
    },
    "./lottie-player": {
      "types": "./lottie-player.d.ts",
      "import": "./lottie-player.mjs",
      "require": "./lottie-player.cjs"
    },
    "./split-text": {
      "types": "./split-text.d.ts",
      "import": "./split-text.mjs",
      "require": "./split-text.cjs"
    },
    "./video-autoplay": {
      "types": "./video-autoplay.d.ts",
      "import": "./video-autoplay.mjs",
      "require": "./video-autoplay.cjs"
    }
  },
  "devDependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "c15t": "^2.1.0",
    "@ovee.js/toolkit": "workspace:*",
    "@types/google.maps": "^3.65.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^17.0.12",
    "@vue/reactivity": "^3.4.15",
    "@vue/runtime-core": "^3.4.15",
    "gsap": "^3.15.0",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "ovee.js": "^3.0.0-alpha.9",
    "swiper": "^14.0.5",
    "typescript": "^5.6.2",
    "vanilla-lazyload": "^19.1.3"
  },
  "peerDependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "c15t": "^2.1.0",
    "@ovee.js/toolkit": "workspace:*",
    "gsap": "^3.15.0",
    "lodash": "^4.18.1",
    "lottie-web": "^5.13.0",
    "ovee.js": "^3.0.0-alpha.9",
    "swiper": "^14.0.5",
    "vanilla-lazyload": "^19.1.3"
  },
  "peerDependenciesMeta": {
    "@googlemaps/js-api-loader": {
      "optional": true
    },
    "c15t": {
      "optional": true
    },
    "gsap": {
      "optional": false
    },
    "lodash": {
      "optional": false
    },
    "lottie-web": {
      "optional": true
    },
    "ovee.js": {
      "optional": false
    },
    "swiper": {
      "optional": true
    },
    "vanilla-lazyload": {
      "optional": true
    }
  }
}
